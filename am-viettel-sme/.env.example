# Local-only development. Change the placeholder password before starting PostgreSQL.
APP_ENV=local
DATABASE_URL=postgresql://am:change-me-local-only@127.0.0.1:5432/am_sme?schema=public
REDIS_URL=redis://127.0.0.1:6379/0
PUBLIC_SIGNUP_ENABLED=false
DATA_MODE=synthetic
ZALO_SEND_MODE=disabled
APP_ORIGIN=http://127.0.0.1:3000
POSTGRES_PASSWORD=change-me-local-only

# Approved auth lifetimes: 8 hours per session and 24 hours per invitation (milliseconds).
AUTH_SESSION_TTL_MS=28800000
AUTH_INVITATION_TTL_MS=86400000

# Module 02 (MOD-PB-002): Google OAuth & Drive/Docs Content Importer
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/v1/google/oauth/callback

# Module 02 & 03: Isolated Playwright Browser Profiles & Evidence Storage
BROWSER_PROFILES_ROOT=storage/browser_profiles
PUBLISHING_EVIDENCE_DIR=storage/evidence

# Module 04 (MOD-OPS-004): Telegram Bot Notifications & Kill Switch Operator Guard
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_OPERATOR_IDS=

# Set for the one-time CLI bootstrap only; this sample workspace is synthetic.
# AUTH_BOOTSTRAP_WORKSPACE_SLUG=am-sme-local-synthetic

# For staging only, configure an explicitly approved retention period in days.
# DATA_RETENTION_DAYS=

# For an approved test dataset, set a documented approval ID and change DATA_MODE to approved_test.
# TEST_DATA_APPROVAL_ID=
