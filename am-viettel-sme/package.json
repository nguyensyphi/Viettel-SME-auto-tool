{
  "name": "am-viettel-sme",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "db:format": "pnpm --filter @am-sme/database db:format",
    "db:validate": "pnpm --filter @am-sme/database db:validate",
    "db:generate": "pnpm --filter @am-sme/database db:generate",
    "db:migrate:deploy": "pnpm --filter @am-sme/database db:migrate:deploy",
    "db:seed:synthetic": "pnpm --filter @am-sme/database db:seed:synthetic",
    "db:bootstrap-admin": "pnpm --filter @am-sme/database db:bootstrap-admin",
    "db:recover-admin-password": "pnpm --filter @am-sme/database db:recover-admin-password"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "zod": "^4.1.12"
  }
}
